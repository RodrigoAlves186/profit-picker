{%- comment -%} Profit Picker — destaque colado na variante (mesma cor, uma peça só) {%- endcomment -%}
{%- if template.name == 'product' -%}
  {%- assign pp_id = product.metafields.profit_picker.variant_id | default: "" | remove: "gid://shopify/ProductVariant/" -%}
  {%- if pp_id != blank and block.settings.enable_badge and product.has_only_default_variant == false -%}
    {%- assign pp_variant = nil -%}
    {%- for v in product.variants -%}
      {%- assign vidstr = v.id | append: "" -%}
      {%- if vidstr == pp_id -%}{%- assign pp_variant = v -%}{%- endif -%}
    {%- endfor -%}
    {%- if pp_variant -%}
      {%- assign pp_bg = product.metafields.profit_picker.badge_color | default: "#1a4d2e" -%}
      {%- assign pp_fg = product.metafields.profit_picker.badge_text_color | default: "#ffffff" -%}
      {%- assign pp_default_text = 'profit_picker.default_badge_text' | t -%}
      {%- assign pp_text = product.metafields.profit_picker.badge_text | default: pp_default_text -%}
      <style>
        .pp-mark{position:relative !important;overflow:visible !important;box-shadow:0 0 0 2px {{ pp_bg }} !important;z-index:2 !important}
        .pp-mark .variant-option__button-label__pill{display:none !important}
        .pp-host{overflow:visible !important;margin-bottom:28px !important}
        .pp-badge{position:absolute;top:100%;left:50%;transform:translateX(-50%);background:{{ pp_bg }};color:{{ pp_fg }};font-family:inherit;font-size:9px;font-weight:800;line-height:1.05;text-transform:uppercase;letter-spacing:.03em;text-align:center;padding:3px 7px;border-radius:0 0 7px 7px;white-space:nowrap;pointer-events:none;z-index:1}
        .pp-badge span{display:block}
        .pp-note{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:0 0 14px;font-family:inherit;font-size:14px;line-height:1.3}
        .pp-note__badge{background:{{ pp_bg }};color:{{ pp_fg }};font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;padding:5px 10px;border-radius:999px}
        .pp-note__variant{font-weight:600}
      </style>
      <script>
        (function(){
          var VID = "{{ pp_id }}";
          var OPTS = [
            {%- for opt_name in product.options -%}
              {name: {{ opt_name | json }}, value: {{ pp_variant.options[forloop.index0] | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ];
          var TEXT = {{ pp_text | json }};
          var TITLE = {{ pp_variant.title | json }};
          var observer;
          function labelFor(inp){
            if(inp.closest('label')) return inp.closest('label');
            if(inp.id){ var id=(window.CSS&&CSS.escape)?CSS.escape(inp.id):inp.id; var l=document.querySelector('label[for="'+id+'"]'); if(l) return l; }
            return inp.closest('[class*="swatch"]') || inp.parentElement;
          }
          function mark(el){
            if(!el || el.classList.contains('pp-mark')) return;
            el.classList.add('pp-mark');
            var host = el.closest('fieldset') || el.parentElement;
            if(host) host.classList.add('pp-host');
            var b=document.createElement('span');
            b.className='pp-badge';
            b.innerHTML = TEXT.trim().split(/\s+/).map(function(w){return '<span>'+w+'</span>';}).join('');
            el.appendChild(b);
          }
          // The main product form; cart drawers and quick-add modals also contain add-to-cart forms.
          function productForm(){
            var forms = Array.prototype.filter.call(document.querySelectorAll('form[action*="/cart/add"]'), function(f){
              return !f.closest('cart-drawer,.cart-drawer,dialog,[class*="quick-add"],[class*="drawer"],header,footer');
            });
            return forms[0] || null;
          }
          // Themes that show variants in a dropdown have no option button to attach to, so the
          // badge and the variant name go above the add-to-cart controls instead.
          function note(){
            var form = productForm();
            if(!form) return;
            var el=document.createElement('div');
            el.className='pp-note';
            var b=document.createElement('span');
            b.className='pp-note__badge';
            b.textContent=TEXT;
            el.appendChild(b);
            var t=document.createElement('span');
            t.className='pp-note__variant';
            t.textContent=TITLE;
            el.appendChild(t);
            form.parentNode.insertBefore(el, form);
          }
          function run(){
            // Our own DOM changes must not wake the observer, or run() would loop forever.
            if(observer) observer.disconnect();
            document.querySelectorAll('.pp-badge,.pp-note').forEach(function(e){e.remove();});
            document.querySelectorAll('.pp-mark').forEach(function(e){e.classList.remove('pp-mark');});
            document.querySelectorAll('.pp-host').forEach(function(e){e.classList.remove('pp-host');});
            // Only clickable variant choices: themes like Dawn also put data-variant-id
            // on non-picker blocks (pickup availability), which must not get the badge.
            var hit = Array.prototype.filter.call(document.querySelectorAll('[data-variant-id="'+VID+'"]'), function(el){
              return el.matches('input,button,label,li,[role="radio"],[role="option"]');
            });
            if(hit.length){
              hit.forEach(function(el){ mark(el.tagName==='INPUT' ? labelFor(el) : (el.closest('label')||el)); });
            } else {
              OPTS.forEach(function(o){
                document.querySelectorAll('input[type="radio"]').forEach(function(inp){
                  if((inp.name||'').toLowerCase().indexOf(String(o.name).toLowerCase())!==-1 && inp.value===String(o.value)) mark(labelFor(inp));
                });
              });
            }
            if(!document.querySelector('.pp-mark')) note();
            if(observer) observer.observe(document.body,{childList:true,subtree:true});
          }
          function boot(){
            var t;
            observer = new MutationObserver(function(){clearTimeout(t);t=setTimeout(run,200);});
            run();
            document.addEventListener('change',function(){setTimeout(run,150);});
          }
          if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot); else boot();
        })();
      </script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Profit Picker",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_badge",
      "label": "Enable Profit Picker badge",
      "default": true,
      "info": "Shows the highlighted variant badge on product pages. Configure which variant to highlight inside the Profit Picker app."
    }
  ]
}
{% endschema %}